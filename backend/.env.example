# ==========================================
# PDF RAG Application - Environment Config
# ==========================================

# 1. LLM Provider API Key (Required for answering questions)
# Examples:
#   - OpenAI: sk-proj-...
#   - Groq (Free fast tier): gsk_...
#   - OpenRouter: sk-or-v1-...
#   - Ollama (Local): ollama (or any non-empty string)
LLM_API_KEY=your_api_key_here

# 2. LLM Base URL (OpenAI-compatible endpoint)
# Examples:
#   - OpenAI: https://api.openai.com/v1
#   - Groq: https://api.groq.com/openai/v1
#   - OpenRouter: https://openrouter.ai/api/v1
#   - Local Ollama: http://localhost:11434/v1
#   - DeepSeek: https://api.deepseek.com/v1
LLM_BASE_URL=https://api.openai.com/v1

# 3. Model Name
# Examples:
#   - OpenAI: gpt-4o-mini (or gpt-3.5-turbo, gpt-4o)
#   - Groq: llama-3.3-70b-versatile (or llama3-8b-8192)
#   - OpenRouter: meta-llama/llama-3.1-8b-instruct:free
#   - Local Ollama: llama3:latest
LLM_MODEL=gpt-4o-mini

# 4. Embeddings Model Name (OpenAI-compatible)
# Default for OpenAI is "text-embedding-3-small"
EMBEDDING_MODEL=text-embedding-3-small

# 5. Retrieval Settings
# Number of relevant chunks retrieved per question
TOP_K=4
